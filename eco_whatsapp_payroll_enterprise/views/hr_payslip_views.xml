<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_whatsapp_enterprise" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.whatsapp.enterprise</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" string="Send via WhatsApp" type="object" icon="fa-whatsapp" invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
