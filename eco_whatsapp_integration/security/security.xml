<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_eco_whatsapp" model="ir.module.category">
        <field name="name">Eco WhatsApp Integration</field>
        <field name="description">Access rights for Eco WhatsApp Integration module.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_eco_whatsapp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_eco_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_eco_whatsapp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_eco_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('group_eco_whatsapp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="eco_whatsapp_log_comp_rule" model="ir.rule">
        <field name="name">Eco WhatsApp Log Multi-Company Rule</field>
        <field name="model_id" ref="model_eco_whatsapp_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
