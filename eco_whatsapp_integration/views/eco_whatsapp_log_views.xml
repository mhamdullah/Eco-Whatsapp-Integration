<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Log List View -->
    <record id="view_eco_whatsapp_log_list" model="ir.ui.view">
        <field name="name">eco.whatsapp.log.list</field>
        <field name="model">eco.whatsapp.log</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Audit Logs" create="0" edit="0" delete="0">
                <field name="create_date" string="Datetime"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="document_type"/>
                <field name="document_ref"/>
                <field name="status" widget="badge" decoration-success="status == 'draft_opened'" decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_eco_whatsapp_log_form" model="ir.ui.view">
        <field name="name">eco.whatsapp.log.form</field>
        <field name="model">eco.whatsapp.log</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="document_ref" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="phone_number"/>
                        </group>
                        <group>
                            <field name="document_type"/>
                            <field name="status"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Log Search View -->
    <record id="view_eco_whatsapp_log_search" model="ir.ui.view">
        <field name="name">eco.whatsapp.log.search</field>
        <field name="model">eco.whatsapp.log</field>
        <field name="arch" type="xml">
            <search string="Search WhatsApp Logs">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="phone_number"/>
                <field name="document_ref"/>
                <filter string="Draft Opened" name="draft_opened" domain="[('status', '=', 'draft_opened')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Document Type" name="group_doc_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_eco_whatsapp_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">eco.whatsapp.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_eco_whatsapp_log_search"/>
    </record>

    <!-- Menu Structure -->
    <menuitem id="menu_eco_whatsapp_root" name="Eco WhatsApp" parent="base.menu_administration" sequence="30" groups="group_eco_whatsapp_user"/>
    <menuitem id="menu_eco_whatsapp_settings" name="Settings" parent="menu_eco_whatsapp_root" action="action_eco_whatsapp_config" sequence="10" groups="group_eco_whatsapp_manager"/>
    <menuitem id="menu_eco_whatsapp_logs" name="Audit Logs" parent="menu_eco_whatsapp_root" action="action_eco_whatsapp_log" sequence="20" groups="group_eco_whatsapp_user"/>
</odoo>
