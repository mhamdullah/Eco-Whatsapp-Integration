<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_send_whatsapp" type="object" class="oe_stat_button" icon="fa-whatsapp" invisible="not eco_wa_number">
                    <div class="o_stat_info">
                        <span class="o_stat_text" style="font-weight: bold; color: #10b981; display: block;">Send WhatsApp</span>
                        <span class="o_stat_text" style="font-size: 10px; display: block;"><field name="eco_wa_number"/></span>
                        <span class="o_stat_text" style="font-size: 9px; display: block;" invisible="not eco_wa_last_sent_date">
                            Sent: <field name="eco_wa_last_sent_date" widget="date"/>
                        </span>
                    </div>
                </button>
            </div>
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="eco_wa_number" readonly="1" string="WhatsApp normalized"/>
            </xpath>
        </field>
    </record>
</odoo>
