<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_whatsapp" string="Send via WhatsApp" type="object" icon="fa-whatsapp" invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
